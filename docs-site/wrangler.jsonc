{
  "name": "vagejs-example-docs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [{ "pattern": "docs-demo.vagejs.com", "custom_domain": true }],
  "assets": {
    "directory": "dist",
    // Serve dist/404.html with a 404 status for unknown addresses.
    "not_found_handling": "404-page"
  }
}
